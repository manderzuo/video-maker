{
  "name": "aiwork-studio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": "11.6.2"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts vitest.config.ts playwright.config.ts companion/src companion/vite.config.ts",
    "test:unit": "vitest run",
    "test:e2e": "node --experimental-strip-types scripts/run-browser-tests.mjs test",
    "test:acceptance": "node --experimental-strip-types scripts/run-browser-tests.mjs --studio-static test -c playwright.acceptance.config.ts",
    "test:security": "vitest run tests/security && node scripts/check-network-negative.mjs",
    "test:trace": "node --test tests/planning/*.test.mjs",
    "test:coverage": "node scripts/check-ui-identities.mjs && node scripts/check-traceability.mjs",
    "test:coverage:cloud": "node scripts/check-ui-identities.mjs && node scripts/check-traceability.mjs --cloud",
    "test:trace:cloud": "node --test tests/planning/cloud-*.test.mjs",
    "verify:cloud": "npm run typecheck && npm run lint && npm run test:unit && npm run test:coverage:cloud && npm run test:trace:cloud && npm run build && npm run test:bundle && npm run verify:cloud:server && npm run verify:cloud:security",
    "verify:cloud:server": "npm --prefix server run typecheck && npm --prefix server run test",
    "verify:cloud:security": "npm run test:security",
    "test:live": "node scripts/run-authorized-live.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:e2e && npm run test:coverage && npm run test:security && npm run test:trace && npm run build && npm run test:bundle && npm run companion:build && npm run test:distribution",
    "companion:build": "vite build --config companion/vite.config.ts",
    "companion:start": "node companion/dist/main.mjs",
    "companion:mcp": "node companion/dist/mcp.mjs",
    "test:performance": "playwright test --config tests/performance/performance.config.ts",
    "test:bundle": "node scripts/check-bundle-budget.mjs",
    "test:distribution": "playwright test --config playwright.distribution.config.ts",
    "package:review": "node scripts/package-release.mjs --offline-review",
    "test:live-guard": "node --test tests/live/guard.test.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.3.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.11.0",
    "fake-indexeddb": "6.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
